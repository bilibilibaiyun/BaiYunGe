<Window x:Class="BaiYunGe.Bootstrapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BaiYunGe Setup"
        Width="540"
        Height="300"
        MinWidth="480"
        MinHeight="260"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#FFF7F7F8"
        Foreground="#FF18181B">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="LanguageLabel"
                       Margin="0,16,0,6" />
            <ComboBox x:Name="LanguageCombo"
                      Width="240"
                      HorizontalAlignment="Left"
                      SelectionChanged="LanguageCombo_SelectionChanged" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="ProgressBar"
                         Width="16"
                         Height="16"
                         VerticalAlignment="Center"
                         IsIndeterminate="True"
                         Visibility="Collapsed" />
            <TextBlock x:Name="StatusText"
                       Grid.Column="1"
                       Margin="10,0,0,0"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </Grid>

        <TextBlock x:Name="MessageText"
                   Grid.Row="2"
                   Margin="0,18,0,12"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="RepairButton"
                    Width="90"
                    Margin="0,0,8,0"
                    Visibility="Collapsed"
                    Click="RepairButton_Click" />
            <Button x:Name="UninstallButton"
                    Width="90"
                    Margin="0,0,8,0"
                    Visibility="Collapsed"
                    Click="UninstallButton_Click" />
            <Button x:Name="InstallButton"
                    Width="90"
                    Margin="0,0,8,0"
                    Click="InstallButton_Click" />
            <Button x:Name="CancelButton"
                    Width="90"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
