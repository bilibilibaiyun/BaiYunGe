<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <AssemblyName>BaiYunGe</AssemblyName>
    <RootNamespace>BaiYunGe</RootNamespace>
    <Version>3.2.5</Version>
    <AssemblyVersion>3.2.5.0</AssemblyVersion>
    <FileVersion>3.2.5.0</FileVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>zh-CN;en-US</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 唯一第三方依赖：NAudio（WASAPI 录音与 WAV 写入） -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- 只用 WinForms 的 NotifyIcon，移除其 implicit using 以避免与 WPF 控件类型歧义 -->
    <Using Remove="System.Windows.Forms" />
    <!-- WindowsDesktop SDK 的 implicit usings 不包含 System.IO / System.Net.Http，显式补全 -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内置 llama.cpp 引擎运行时，随输出/发布复制。
         用 Always 而非 PreserveNewest：引擎 DLL 的修改时间是下载/构建时间（可能早于
         目标目录里的旧文件），PreserveNewest 会误判旧文件「更新」而不复制，导致
         发布/安装包里残留旧引擎（报 0xC0000135 DLL 缺失）。 -->
    <None Include="..\..\engine\llama-server\**\*"
          Link="engine\llama-server\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="Always"
          CopyToPublishDirectory="Always" />
    <!-- 应用图标（程序图标/托盘/窗口标题栏） -->
    <Content Include="Assets\app.ico"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\app-square.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
